/* ============================================================
   知行岛 · Design Tokens（三层架构）
   Layer 1 Primitive → Layer 2 Semantic → Layer 3 Component
   老变量名（--color-primary / --radius-card / --shadow-card ...）
   作为兼容别名保留在最底部，计算值与旧版完全一致。
   ============================================================ */
page {
  /* -------- Layer 1 · Primitive（硬编码 hex，禁止 var 引用）-------- */

  /* Green scale（品牌绿）*/
  --green-50:  #F4FAF6;
  --green-100: #E8F5E9;
  --green-200: #D8F3DC;
  --green-400: #52B788;
  --green-500: #43976B;
  --green-600: #40916C;
  --green-700: #2D6A4F;
  --green-900: #1B4332;

  /* Neutral scale */
  --neutral-0:   #FFFFFF;
  --neutral-50:  #F0F4F1;
  --neutral-100: #EEF4F0;
  --neutral-200: #E8ECEA;
  --neutral-300: #CFD8DC;
  --neutral-500: #8C9BA5;
  --neutral-700: #3D5245;
  --neutral-900: #1C2B20;

  /* Accent / Feedback */
  --amber-50:  #FFF8E6;
  --amber-100: #FDEFD0;
  --amber-400: #FFB703;
  --amber-500: #FB8500;
  --amber-800: #8A6D3B;
  --coral-500: #E07A5F;
  --blue-50:   #EAF2F8;

  /* Space scale（8rpx 基准）*/
  --space-1:  8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;

  /* Radius scale */
  --radius-xs: 8rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-pill: 999rpx;

  /* Type scale（8 档，正在收敛中）*/
  --font-xs:   20rpx;
  --font-sm:   22rpx;
  --font-base: 24rpx;
  --font-md:   26rpx;
  --font-lg:   30rpx;
  --font-xl:   34rpx;
  --font-2xl:  40rpx;
  --font-3xl:  56rpx;

  /* Weight scale */
  --weight-regular:  400;
  --weight-medium:   500;
  --weight-semibold: 600;
  --weight-bold:     700;
  --weight-black:    800;

  /* Shadow scale */
  --shadow-xs:    0 2rpx 8rpx  rgba(28, 43, 32, 0.04);
  --shadow-sm:    0 4rpx 24rpx rgba(28, 43, 32, 0.06);
  --shadow-md:    0 8rpx 24rpx rgba(28, 43, 32, 0.10);
  --shadow-lg:    0 16rpx 40rpx rgba(28, 43, 32, 0.14);
  --shadow-brand:        0 8rpx 20rpx rgba(82, 183, 136, 0.30);
  --shadow-brand-soft:   0 8rpx 24rpx rgba(45, 106, 79, 0.10);
  --shadow-brand-strong: 0 12rpx 32rpx rgba(45, 106, 79, 0.36);
  --shadow-accent:       0 6rpx 16rpx rgba(251, 133, 0, 0.32);
  --shadow-inset-top:    0 -4rpx 24rpx rgba(28, 43, 32, 0.08);

  /* -------- Layer 2 · Semantic -------- */

  /* Brand */
  --color-primary:        var(--green-400);
  --color-primary-hover:  var(--green-600);
  --color-primary-active: var(--green-700);
  --color-primary-soft:   var(--green-200);
  --color-primary-fg:     var(--neutral-0);

  /* Surface */
  --color-bg-page:   var(--green-50);
  --color-bg-card:   var(--neutral-0);
  --color-bg-sunken: var(--neutral-100);

  /* Text */
  --color-text:           var(--neutral-900);
  --color-text-secondary: var(--neutral-500);
  --color-text-brand:     var(--green-700);
  --color-text-on-brand:  var(--neutral-0);

  /* Border / Divider */
  --color-border:        var(--neutral-100);
  --color-border-strong: var(--neutral-300);

  /* Feedback */
  --color-warning-bg: var(--amber-50);
  --color-warning-fg: var(--amber-800);
  --color-danger:     var(--coral-500);
  --color-accent:     var(--amber-500);
  --color-info-bg:    var(--blue-50);

  /* -------- Layer 3 · Component -------- */

  /* Button */
  --btn-height-md: 96rpx;
  --btn-height-sm: 88rpx;
  --btn-radius:    var(--radius-md);
  --btn-shadow:    var(--shadow-brand);

  /* Card */
  --card-radius:   var(--radius-lg);
  --card-shadow:   var(--shadow-sm);
  --card-padding:  var(--space-4);

  /* Hero */
  --hero-radius-bottom: var(--radius-xl);
  --hero-shadow:        var(--shadow-lg);

  /* Chip */
  --chip-radius:  var(--radius-xl);
  --chip-padding: 12rpx 28rpx;

  /* -------- Legacy 兼容别名（旧变量名 → 新 token）--------
     旧代码继续能用；计算值与改动前完全一致。 */
  --color-primary-dark:   var(--green-700);      /* = var(--color-text-brand) */
  --color-primary-light:  var(--green-200);      /* = var(--color-primary-soft) */
  --color-disabled:       var(--neutral-300);    /* = var(--color-disabled) */
  --color-warning-text:   var(--color-warning-fg);
  --radius-card:          var(--radius-lg);      /* = 32rpx */
  --radius-btn:           var(--radius-md);      /* = 24rpx */
  --radius-chip:          var(--radius-xl);      /* = 40rpx */
  --shadow-card:          var(--shadow-sm);      /* = 0 4rpx 24rpx rgba(28,43,32,.06) */

  /* -------- Base -------- */
  background: var(--color-bg-page);
  color: var(--color-text);
  font-size: var(--font-md);
  line-height: 1.5;
}

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-bg-card);
  border-radius: var(--radius-btn);
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin: 24rpx auto;
  width: 90%;
  box-shadow: var(--btn-shadow);
}

.btn-primary:active {
  background: var(--color-primary-active);
  transform: scale(0.98);
}

.btn-primary.disabled,
.btn-primary.disabled:active {
  background: var(--color-disabled);
  color: var(--color-text-secondary);
  box-shadow: none;
  opacity: 1;
  transform: none;
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-btn);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 16rpx auto;
  width: 90%;
}

.btn-outline:active {
  background: var(--color-primary-soft);
  transform: scale(0.98);
}

/* Danger 变体：破坏性操作（取消/提前离座/删除）*/
.btn-danger {
  background: transparent;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
  border-radius: var(--btn-radius);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 16rpx auto;
  width: 90%;
}

.btn-danger:active {
  background: rgba(224, 122, 95, 0.08);
  transform: scale(0.98);
}

.btn-danger-solid {
  background: var(--color-danger);
  color: var(--color-bg-card);
  border-radius: var(--btn-radius);
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin: 24rpx auto;
  width: 90%;
  box-shadow: 0 8rpx 20rpx rgba(224, 122, 95, 0.30);
}

.btn-danger-solid:active {
  background: #C86851;
  transform: scale(0.98);
}

/* 文本级 danger 链接（用于卡片内嵌操作，如"提前离座"）*/
.link-danger {
  color: var(--color-danger);
  font-weight: 600;
  padding: 10rpx 20rpx;
}

.link-danger:active {
  opacity: 0.7;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-chip);
  font-size: 24rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
  margin-right: 16rpx;
}

.chip:active {
  background: var(--color-primary-soft);
  transform: scale(0.98);
}

.chip.active {
  background: var(--color-primary);
  color: var(--color-bg-card);
  border-color: var(--color-primary);
}

.chip.disabled,
.chip.disabled:active {
  border-color: var(--color-border-strong);
  color: var(--color-text-secondary);
  background: transparent;
  transform: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-chip);
  font-size: 22rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
}

.tag.gray {
  background: var(--color-border);
  color: var(--color-text-secondary);
}

.empty {
  text-align: center;
  color: var(--color-text-secondary);
  padding: 80rpx 32rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.label {
  margin: 24rpx 0 8rpx;
  font-weight: 600;
  font-size: 28rpx;
  color: var(--color-primary-dark);
}

.hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin: 16rpx 0;
  line-height: 1.6;
}

.picker-box {
  padding: 20rpx 24rpx;
  background: var(--color-bg-page);
  border-radius: 16rpx;
  color: var(--color-text);
  border: 2rpx solid var(--color-primary-light);
}

.page-safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 悬浮胶囊 tabBar 的内容避让（仅 tab 页使用） */
.tabbar-clear {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom)) !important;
}

.fixed-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-inset-top);
  z-index: 100;
}

.fixed-bottom-spacer {
  height: 180rpx;
}

/* ============ 选座平面图 · 共用 ============ */
.seat-legend {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.seat-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  background: var(--color-bg-page);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.seat-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.seat-dot.available {
  background: var(--color-primary);
  border-color: var(--green-500);
}

.seat-dot.selected {
  background: var(--green-900);
  border-color: var(--color-bg-card);
  box-shadow: 0 0 0 2rpx var(--green-900);
}

.seat-dot.reserved {
  background: #F4D89A;
  border-color: #C9A227;
}

.seat-dot.occupied {
  background: #C9D0CB;
  border-color: rgba(90, 105, 96, 0.55);
}

.seat-count {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(120deg, #F4FAF6, #F4FAF6);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
}

.seat-count-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.seat-badge {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  background: var(--color-bg-page);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.seat-badge--on {
  background: linear-gradient(135deg, #52B788, #2D6A4F);
  color: var(--color-bg-card);
  box-shadow: var(--shadow-brand);
}

.seat-badge-no {
  font-size: 26rpx;
  font-weight: 800;
}

.seat-badge-dot {
  opacity: 0.75;
  font-weight: 700;
}

.seat-badge-zone {
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.95;
}

.seat-badge:not(.seat-badge--on) .seat-badge-zone {
  opacity: 1;
}

.seat-map-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin: -12rpx 0 20rpx;
  line-height: 1.5;
}

.seat-map-frame {
  position: relative;
  width: 100%;
  padding-bottom: 77.78%;
  height: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #F4FAF6 0%, #F4FAF6 100%);
  box-shadow:
    inset 0 0 0 2rpx rgba(82, 183, 136, 0.28),
    0 8rpx 24rpx rgba(45, 106, 79, 0.08);
}

.seat-map-empty {
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: linear-gradient(160deg, #F4FAF6 0%, #F4FAF6 100%);
  border-radius: 24rpx;
  border: 2rpx dashed rgba(82, 183, 136, 0.35);
}

/* ============ Skeleton loading ============ */
.skeleton-shimmer {
  background: linear-gradient(
    90deg,
    rgba(230, 237, 233, 0.6) 25%,
    rgba(216, 243, 220, 0.9) 50%,
    rgba(230, 237, 233, 0.6) 75%
  );
  background-size: 400% 100%;
  animation: skeleton-wave 1.4s ease infinite;
}

@keyframes skeleton-wave {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--lg {
  height: 40rpx;
  width: 60%;
}

.skeleton-line--sm {
  height: 22rpx;
  width: 40%;
}

.skeleton-store-card {
  margin: 0 24rpx 24rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
}

.skeleton-store-cover {
  height: 280rpx;
}

.skeleton-store-body {
  padding: 24rpx 28rpx 28rpx;
}

.skeleton-seat-map {
  height: 520rpx;
  border-radius: 24rpx;
  margin: 16rpx 0;
}

.skeleton-checkin-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.skeleton-checkin-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 24rpx auto;
}

/* ============ 图标系统（Lucide outline, 统一品牌绿描边）============
   基础：.mi-glyph（40rpx 默认，套 .glyph-lg / .glyph-xl 换尺寸）
   反色：.mi-glyph--invert 用于深色底把绿描边变白
   =============================================================== */
.mi-glyph {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.glyph-lg { width: 60rpx; height: 60rpx; }
.glyph-xl { width: 80rpx; height: 80rpx; }

.mi-glyph--invert { filter: brightness(0) invert(1); }

