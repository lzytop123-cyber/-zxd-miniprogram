.page { padding-bottom: 48rpx; }
.card {
  margin: 24rpx;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.label {
  margin-top: 24rpx;
  margin-bottom: 10rpx;
  color: var(--color-text-brand);
  font-weight: 600;
  font-size: 24rpx;
}
.label:first-child { margin-top: 0; }
.picker, .input {
  background: var(--color-bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  width: 100%;
}
.textarea {
  background: var(--color-bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
}
.images { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-wrap { position: relative; width: 160rpx; height: 160rpx; }
.img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--color-bg-sunken); }
.del {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-danger);
  color: var(--color-bg-card);
  text-align: center;
  line-height: 36rpx;
}
.add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tag-row { display: flex; gap: 12rpx; }
.tag-input { flex: 1; }
.mini-btn {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-primary-soft);
  color: var(--color-text-brand);
  border-radius: 16rpx;
  font-weight: 600;
}
.tags { margin-top: 12rpx; }
.tag {
  display: inline-block;
  margin: 0 8rpx 8rpx 0;
  padding: 6rpx 16rpx;
  background: var(--color-bg-page);
  color: #5C7567;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.tag.on { background: var(--color-primary-soft); color: var(--color-text-brand); }
.btns { margin: 24rpx; }
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-weight: 600;
}
.btn.primary { background: var(--color-primary); color: var(--color-bg-card); }
.btn.off { opacity: 0.6; }
