.page { padding-bottom: 48rpx; }
.card {
  margin: 24rpx;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.label {
  margin-bottom: 16rpx;
  color: var(--color-text-brand);
  font-weight: 600;
  font-size: 24rpx;
}
.row { display: flex; gap: 12rpx; }
.input {
  flex: 1;
  background: var(--color-bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}
.mini-btn {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-primary);
  color: var(--color-bg-card);
  border-radius: 16rpx;
  font-weight: 600;
}
.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.item:last-child { border-bottom: none; }
.name { font-size: 30rpx; color: var(--color-text); }
.sub { margin-top: 4rpx; font-size: 22rpx; color: var(--color-text-secondary); }
.del { color: var(--color-danger); font-size: 26rpx; }
