.page { min-height: 100vh; padding-bottom: 160rpx; }

.search-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
}
.search {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  font-size: 26rpx;
}
.search-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--color-primary);
  color: var(--color-bg-card);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.chips {
  white-space: nowrap;
  padding: 8rpx 24rpx;
}
.chips.wrap {
  white-space: normal;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 24rpx;
  background: var(--color-bg-card);
  color: #5C7567;
  border-radius: 32rpx;
  font-size: 24rpx;
}
.chip.on {
  background: var(--color-primary);
  color: var(--color-bg-card);
  font-weight: 600;
}
.chip.manage {
  background: var(--color-primary-soft);
  color: var(--color-text-brand);
}

.list { padding: 8rpx 24rpx 0; }
.card {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}
.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--color-bg-sunken);
  flex-shrink: 0;
}
.cover.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}
.body { flex: 1; min-width: 0; }
.title {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.45;
  max-height: 80rpx;
  overflow: hidden;
}
.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6F7D73;
}
.st { padding: 2rpx 12rpx; border-radius: 8rpx; }
.st.s0 { color: #B45309; background: #FEF3C7; }
.st.s1 { color: #B91C1C; background: #FEE2E2; }
.st.s2 { color: #166534; background: var(--color-primary-soft); }
.tags { margin-top: 10rpx; }
.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 10rpx;
  background: var(--color-bg-page);
  color: var(--color-text-brand);
  border-radius: 8rpx;
  font-size: 20rpx;
}

.empty {
  padding: 120rpx 48rpx 40rpx;
  text-align: center;
}
.empty-title { font-size: 34rpx; font-weight: 700; color: var(--color-text-brand); }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.empty-btn {
  margin: 36rpx auto 0;
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-primary);
  color: var(--color-bg-card);
  border-radius: 40rpx;
  font-weight: 600;
}
.tip { text-align: center; color: var(--color-text-secondary); font-size: 24rpx; padding: 16rpx; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 64rpx;
  color: var(--color-bg-card);
  background: var(--color-primary);
  border-radius: 50%;
  box-shadow: var(--shadow-brand-strong);
}
