.page { min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.card {
  margin: 24rpx;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.subject { font-weight: 700; color: var(--color-text-brand); font-size: 28rpx; }
.st { padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; }
.st.s0 { color: #B45309; background: #FEF3C7; }
.st.s1 { color: #B91C1C; background: #FEE2E2; }
.st.s2 { color: #166534; background: var(--color-primary-soft); }
.imgs { white-space: nowrap; margin-top: 20rpx; }
.qimg {
  width: 280rpx;
  height: 280rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: var(--color-bg-sunken);
}
.stem {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--color-text);
}
.tags { margin-top: 16rpx; }
.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 12rpx;
  background: var(--color-bg-page);
  color: var(--color-text-brand);
  border-radius: 8rpx;
  font-size: 22rpx;
}
.meta { margin-top: 16rpx; font-size: 22rpx; color: var(--color-text-secondary); }
.answer-toggle {
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-primary-soft);
  color: var(--color-text-brand);
  border-radius: 16rpx;
  font-weight: 600;
}
.answer-text { margin-top: 20rpx; font-size: 28rpx; line-height: 1.6; color: var(--color-text); }
.answer-text.muted { color: var(--color-text-secondary); }
.images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.aimg { width: 200rpx; height: 200rpx; border-radius: 16rpx; background: var(--color-bg-sunken); }
.reason { margin-top: 16rpx; font-size: 24rpx; color: #6F7D73; }
.actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 8rpx 24rpx 24rpx;
}
.link { color: var(--color-text-brand); font-size: 28rpx; font-weight: 600; }
.link.danger { color: var(--color-danger); }
.status-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 12rpx;
  padding: 12rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
}
.sbtn {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  color: #5C7567;
  font-size: 24rpx;
}
.sbtn.on { background: var(--color-primary); color: var(--color-bg-card); font-weight: 600; }
