.page { min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.card {
  margin: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(28, 43, 32, 0.06);
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.subject { font-weight: 700; color: #2D6A4F; font-size: 28rpx; }
.st { padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; }
.st.s0 { color: #B45309; background: #FEF3C7; }
.st.s1 { color: #B91C1C; background: #FEE2E2; }
.st.s2 { color: #166534; background: #D8F3DC; }
.imgs { white-space: nowrap; margin-top: 20rpx; }
.qimg {
  width: 280rpx;
  height: 280rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: #E8ECEA;
}
.stem {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1C2B20;
}
.tags { margin-top: 16rpx; }
.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 12rpx;
  background: #F4FAF6;
  color: #2D6A4F;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.meta { margin-top: 16rpx; font-size: 22rpx; color: #8C9BA5; }
.answer-toggle {
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  background: #D8F3DC;
  color: #2D6A4F;
  border-radius: 16rpx;
  font-weight: 600;
}
.answer-text { margin-top: 20rpx; font-size: 28rpx; line-height: 1.6; color: #1C2B20; }
.answer-text.muted { color: #8C9BA5; }
.images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.aimg { width: 200rpx; height: 200rpx; border-radius: 16rpx; background: #E8ECEA; }
.reason { margin-top: 16rpx; font-size: 24rpx; color: #6F7D73; }
.actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 8rpx 24rpx 24rpx;
}
.link { color: #2D6A4F; font-size: 28rpx; font-weight: 600; }
.link.danger { color: #C95C5C; }
.status-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 12rpx;
  padding: 12rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(28, 43, 32, 0.1);
}
.sbtn {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  background: #F4FAF6;
  color: #5C7567;
  font-size: 24rpx;
}
.sbtn.on { background: #52B788; color: #fff; font-weight: 600; }
