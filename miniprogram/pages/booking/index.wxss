.page-booking {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ============ 门店 Hero（精简，只留渐变+店名） ============ */
.bk-hero {
  padding: 28rpx 32rpx 40rpx;
  background: linear-gradient(150deg, #2D6A4F 0%, #40916C 55%, #52B788 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.bk-hero-store {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-bg-card);
  text-shadow: 0 2rpx 12rpx rgba(15, 45, 30, 0.2);
}

/* ============ 卡片 ============ */
.bk-card {
  margin: 24rpx;
  padding: 30rpx;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
}

.bk-card:first-of-type {
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.bk-sec {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.bk-sec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 0.5rpx;
}

.bk-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 32rpx 0 28rpx;
}

/* ============ 套餐类型 ============ */
.bk-sec--type {
  flex-wrap: wrap;
}

.bk-sec-tag {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-brand);
  padding: 6rpx 16rpx;
  background: var(--color-bg-page);
  border-radius: 999rpx;
}

/* 主类型：横排 chip 一排（多则 wrap） */
.type-primary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-primary {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}

.type-primary:active {
  transform: scale(0.96);
}

.type-primary-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.type-primary.active {
  background: linear-gradient(135deg, #52B788, #2D6A4F);
  border-color: transparent;
  box-shadow: var(--shadow-brand);
}

.type-primary.active .type-primary-label {
  color: var(--color-bg-card);
  font-weight: 700;
}

/* 子类型：同风格 chip，用间距和位置暗示层级 */
.type-sub-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-left: 16rpx;
  border-left: 3rpx solid var(--color-primary-soft);
}

.type-sub {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}

.type-sub:active {
  transform: scale(0.96);
}

.type-sub-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.type-sub-days {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  opacity: 0.7;
}

.type-sub.active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
}

.type-sub.active .type-sub-label {
  color: var(--color-text-brand);
  font-weight: 700;
}

.type-sub.active .type-sub-days {
  color: var(--color-text-brand);
  opacity: 1;
}

/* ============ 字段 pill ============ */
.field-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.field {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}

.field:active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary-soft);
  transform: scale(0.97);
}

.field--static {
  background: transparent;
  border-color: transparent;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.field--static:active {
  background: transparent;
  border-color: transparent;
  transform: none;
}

.field--wide {
  flex: 1;
}

.field-key {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.field-val {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 700;
}

.quick-btns {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 0;
  flex-wrap: wrap;
}

.quick-btns .chip {
  margin-right: 0;
}

.hint {
  font-size: 22rpx;
  color: #9CACA2;
  margin-top: 18rpx;
  line-height: 1.6;
}

.hint--sec {
  margin-top: -8rpx;
  margin-bottom: 8rpx;
}

.preview-error {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FFF5F5;
  color: #C0392B;
  font-size: 24rpx;
  line-height: 1.5;
}

.time-summary {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(120deg, #F4FAF6, #F4FAF6);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-brand);
  font-weight: 500;
}

.ts-icon {
  font-size: 26rpx;
}

/* ============ 选座 ============ */
.bk-card--seat {
  padding-bottom: 26rpx;
}

/* ============ 底部 CTA ============ */
.bk-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-inset-top);
  z-index: 100;
}

.bk-cta {
  padding: 28rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #52B788, #2D6A4F);
  color: var(--color-bg-card);
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 40rpx;
  box-shadow: var(--shadow-brand);
}

.bk-cta.full {
  width: 100%;
}

.bk-cta:active {
  transform: scale(0.98);
}

.bk-cta--disabled {
  background: var(--color-disabled);
  color: var(--color-text-secondary);
  box-shadow: none;
}

.bk-cta--disabled:active {
  transform: none;
}

.seat-map-loading {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 20rpx;
  background: rgba(244, 250, 246, 0.45);
  pointer-events: auto;
}

.seat-map-loading-text {
  font-size: 22rpx;
  color: var(--color-text-brand);
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-brand-soft);
}
