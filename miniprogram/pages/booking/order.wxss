.page-order {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.order-card {
  margin-bottom: 0;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-brand);
  margin-bottom: 16rpx;
}

.section-title.inner {
  padding: 0;
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-bg-page);
  font-size: 26rpx;
}

.row-label {
  color: var(--color-text-secondary);
}

.fee-block {
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.price-row {
  border: none;
  align-items: center;
}

.price {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.discount {
  color: var(--color-primary);
  font-weight: 600;
}

.picker-row {
  padding: 24rpx;
  border: 2rpx dashed var(--color-primary-soft);
  border-radius: 16rpx;
  color: var(--color-text);
  margin-bottom: 16rpx;
  font-size: 26rpx;
  background: var(--color-bg-page);
}

.hint-warn {
  background: var(--color-warning-bg);
  color: var(--color-warning-fg);
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin: 16rpx 0;
  line-height: 1.6;
}

.hint-soft {
  color: #5C7567;
  font-size: 24rpx;
  margin: 8rpx 0 16rpx;
  line-height: 1.5;
}

.pay-types {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
  flex-wrap: wrap;
}

.pay-item {
  flex: 1;
  min-width: 180rpx;
  text-align: center;
  padding: 20rpx 12rpx;
  border: 2rpx solid var(--color-primary-soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.pay-item.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-text-brand);
  font-weight: 600;
}

.pay-summary {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pay-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.pay-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.fixed-bottom-bar .submit-btn {
  margin: 0;
  width: 100%;
}

.submit-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}
