<view class="page-report">
  <view wx:if="{{notLoggedIn}}" class="card guest-report-card">
    <view class="mi-glyph glyph-xl icon-book-open empty-glyph"></view>
    <view class="guest-report-title">登录后查看学习报告</view>
    <view class="guest-report-desc">查看累计自习时长、学习趋势与排行榜</view>
    <view class="btn-primary guest-report-btn" bindtap="goLogin">去登录</view>
  </view>

  <view wx:else class="report-body">
    <view class="report-loading" wx:if="{{reportLoading && !summary && !daily.length && !leaderboard.length}}">正在加载学习报告…</view>
    <view class="report-error" wx:if="{{reportError}}">
      <view>{{reportError}}</view>
      <view class="report-retry" bindtap="retryReport">重新加载报告</view>
    </view>

    <!-- 卡 A：深森绿品牌数据主卡 -->
    <view class="hero-summary" wx:if="{{summary}}">
      <view class="hero-summary-head">
        <view class="hero-title-pill">{{summary.title || '新同学'}}</view>
        <view class="hero-rank" wx:if="{{summary.rank}}">
          <text class="hero-rank-label">当前排名</text>
          <text class="hero-rank-no">#{{summary.rank}}</text>
        </view>
      </view>

      <view class="hero-stats">
        <view class="hero-stat">
          <view class="hero-stat-num">{{summary.total_hours}}<text class="hero-stat-unit">时</text>{{summary.total_minutes_remainder}}<text class="hero-stat-unit">分</text></view>
          <view class="hero-stat-label">累计时长</view>
        </view>
        <view class="hero-stat-sep"></view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{summary.total_sessions}}<text class="hero-stat-unit">次</text></view>
          <view class="hero-stat-label">自习次数</view>
        </view>
        <view class="hero-stat-sep"></view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{summary.daily_avg_minutes}}<text class="hero-stat-unit">分</text></view>
          <view class="hero-stat-label">日均时长</view>
        </view>
      </view>

      <view class="hero-beat" wx:if="{{summary.beat_percent != null}}">
        超越了 {{summary.beat_percent}}% 的同岛学员
      </view>
    </view>

    <!-- 卡 B：趋势图表 -->
    <view class="card report-card">
      <view class="card-head">
        <text class="card-head-title">学习趋势</text>
        <view class="seg-mini">
          <view class="seg-mini-item {{days===7?'active':''}}" bindtap="setDays" data-d="7">近7日</view>
          <view class="seg-mini-item {{days===30?'active':''}}" bindtap="setDays" data-d="30">近30日</view>
        </view>
      </view>
      <view class="daily-chart {{days===30?'daily-chart--dense':''}}" wx:if="{{daily.length}}">
        <view class="daily-bar" wx:for="{{daily}}" wx:key="label">
          <text class="daily-bar-val" wx:if="{{days===7 && item.valueLabel}}">{{item.valueLabel}}</text>
          <view class="daily-bar-track">
            <view class="daily-bar-fill" style="height: {{item.height}}%"></view>
          </view>
          <text class="daily-bar-label">{{item.label}}</text>
        </view>
      </view>
      <view class="daily-empty" wx:elif="{{!reportError}}">近{{days}}日暂无学习记录</view>
    </view>

    <!-- 卡 C：排行榜 -->
    <view class="card report-card">
      <view class="card-head">
        <text class="card-head-title">排行榜</text>
        <view class="seg-mini">
          <view class="seg-mini-item {{scopeLabel==='全平台'?'active':''}}" bindtap="setScope" data-scope="0">全平台</view>
          <view class="seg-mini-item {{scopeLabel==='本店'?'active':''}}" bindtap="setScope" data-scope="1">本店</view>
        </view>
      </view>
      <view class="rank-list">
        <view class="rank-item {{item.is_self?'self':''}}" wx:for="{{leaderboard}}" wx:key="rank">
          <view class="rank {{item.rank <= 3 ? 'rank-medal rank-medal--' + item.rank : ''}}">{{item.rank}}</view>
          <image wx:if="{{item.avatar_url}}" class="rank-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
          <view wx:else class="rank-avatar rank-avatar-ph">岛</view>
          <text class="name">{{item.nickname}}</text>
          <text class="mins">{{item.time_label}}</text>
        </view>
        <view class="empty" wx:if="{{!leaderboard.length && !reportError}}">暂无排行数据</view>
      </view>
    </view>
  </view>
</view>
