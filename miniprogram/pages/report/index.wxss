.page-report {
  min-height: 100vh;
}

.guest-report-card {
  margin: 32rpx 24rpx;
  padding: 64rpx 36rpx;
  text-align: center;
}

.guest-report-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.guest-report-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 36rpx;
}

.guest-report-btn {
  max-width: 360rpx;
  margin: 0 auto;
}

/* 报告主体：底部避让悬浮 tabBar */
.report-body {
  padding: 20rpx 0 calc(160rpx + env(safe-area-inset-bottom));
}

.report-loading,
.report-error {
  margin: 0 24rpx 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.report-error {
  background: var(--color-warning-bg);
  color: var(--color-warning-fg);
}

.report-retry {
  width: 220rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  margin: 20rpx auto 0;
  border-radius: 999rpx;
  background: var(--color-primary-active);
  color: var(--color-bg-card);
  font-weight: 600;
}

/* ============ 卡 A：深森绿品牌数据主卡 ============ */
.hero-summary {
  margin: 0 24rpx 24rpx;
  padding: 32rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #1B4332 0%, #2D6A4F 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(27, 67, 50, 0.2);
}

.hero-summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #E8F5EE;
  background: rgba(255, 255, 255, 0.14);
}

.hero-rank {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
}

.hero-rank-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-rank-no {
  font-size: 32rpx;
  font-weight: 800;
  color: #F5D78E;
  font-variant-numeric: tabular-nums;
}

.hero-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 4rpx 0 8rpx;
}

.hero-stat {
  flex: 1;
  text-align: center;
}

.hero-stat-sep {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.14);
  flex-shrink: 0;
}

.hero-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.hero-stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.78;
  margin: 0 2rpx;
}

.hero-stat-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-beat {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ============ 通用报告白卡 ============ */
.report-card {
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(27, 67, 50, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(27, 67, 50, 0.045);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 精致小分段切换（近7日/近30日 & 全平台/本店） */
.seg-mini {
  display: inline-flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  border: 1rpx solid rgba(27, 67, 50, 0.08);
}

.seg-mini-item {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  transition: background 0.15s ease, color 0.15s ease;
}

.seg-mini-item.active {
  background: var(--color-bg-card);
  color: var(--color-text-brand);
  box-shadow: 0 2rpx 8rpx rgba(27, 67, 50, 0.08);
}

/* ============ 每日学习时长趋势 ============ */
.daily-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 236rpx;
  padding: 12rpx 4rpx 0;
  overflow-x: auto;
}

.daily-chart--dense {
  gap: 8rpx;
}

.daily-bar {
  flex: 1 0 auto;
  min-width: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.daily-bar-val {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 6rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.daily-bar-track {
  width: 24rpx;
  height: 156rpx;
  border-radius: 999rpx;
  background: #EFF4F1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.daily-chart--dense .daily-bar-track {
  width: 16rpx;
}

.daily-bar-fill {
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #40916C 0%, #2D6A4F 100%);
  transition: height 0.25s ease;
}

.daily-bar-label {
  font-size: 19rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.daily-empty {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* ============ 排行榜 ============ */
.rank-list {
  display: flex;
  flex-direction: column;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid rgba(27, 67, 50, 0.06);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item.self {
  background: #F4FAF6;
  border-radius: 16rpx;
  margin: 4rpx -8rpx;
  padding: 18rpx 20rpx;
  border-bottom-color: transparent;
}

.rank {
  width: 44rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.rank-medal {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
}

.rank-medal--1 {
  background: linear-gradient(135deg, #F5D78E, #D4A43C);
  color: #5C4108;
}

.rank-medal--2 {
  background: linear-gradient(135deg, #E5E9EC, #C4CCD2);
  color: #3E4A52;
}

.rank-medal--3 {
  background: linear-gradient(135deg, #E8C3A3, #C58B5B);
  color: #5B3517;
}

.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.rank-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2D6A4F, #1B4332);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mins {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-brand);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.empty {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* ============ 极净白底数据主卡（去闷重深绿大块）============ */
.hero-summary {
  background: #FFFFFF;
  color: var(--color-text);
  border: 1rpx solid rgba(17, 24, 28, 0.05);
  box-shadow: var(--shadow-sm);
}

.hero-title-pill {
  color: var(--color-primary);
  background: #EBF3EE;
}

.hero-rank-label {
  color: var(--color-text-secondary);
}

.hero-rank-no {
  color: var(--color-primary);
}

.hero-stat-sep {
  background: rgba(17, 24, 28, 0.08);
}

.hero-stat-num {
  color: #11181C;
  font-size: 38rpx;
}

.hero-stat-unit {
  color: var(--color-text-secondary);
  opacity: 1;
}

.hero-stat-label {
  color: var(--color-text-secondary);
}

.hero-beat {
  border-top: 1rpx solid rgba(17, 24, 28, 0.06);
  color: var(--color-text-secondary);
}

.daily-bar-fill {
  background: #2D6A4F;
}
