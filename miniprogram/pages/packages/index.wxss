.packages-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.store-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 32rpx 8rpx;
}

.store-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-switch {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  padding: 8rpx 24rpx 20rpx;
  gap: 32rpx;
}

.tab-item {
  position: relative;
  padding: 8rpx 4rpx 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tab-item.active {
  color: var(--color-text-brand);
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

/* ============ 购买区域 ============ */
.buy-body {
  padding: 8rpx 24rpx 24rpx;
}

.loading {
  padding: 80rpx;
  text-align: center;
  color: var(--color-text-secondary);
}

.pkg-list {
  padding-top: 8rpx;
}

.pkg-ticket {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2D6A4F 0%, #40916C 55%, #52B788 100%);
  color: var(--color-bg-card);
  box-shadow: var(--shadow-brand);
}

.pkg-deco {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 10rpx,
    rgba(255, 255, 255, 0.05) 10rpx,
    rgba(255, 255, 255, 0.05) 20rpx
  );
  pointer-events: none;
}

.pkg-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-right: 40rpx;
}

.pkg-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.pkg-price {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
}

.pkg-price-num {
  font-size: 40rpx;
  font-weight: 800;
}

.pkg-tags {
  margin-top: 16rpx;
}

.pkg-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.pkg-rule {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  opacity: 0.9;
  padding-right: 60rpx;
}

.pkg-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

/* 查看详情：文字链接（次要） */
.pkg-detail {
  padding: 6rpx 4rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.pkg-detail:active {
  opacity: 0.65;
}

/* 立即购买：主 CTA（白/绿实心胶囊） */
.pkg-buy {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: var(--color-bg-card);
  color: var(--color-text-brand);
  font-size: 26rpx;
  font-weight: 700;
  transition: transform 0.12s ease;
}

.pkg-buy:active {
  transform: scale(0.96);
}

.buy-empty {
  margin-top: 16rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  box-shadow: var(--shadow-card);
}

.buy-empty .empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

/* ============ 详情弹层 ============ */
.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  width: 100%;
  max-height: 75vh;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}

.detail-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 8rpx auto 24rpx;
  border-radius: 999rpx;
  background: #E0E0E0;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.35;
}

.detail-subtitle {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.detail-lines {
  margin-top: 28rpx;
  max-height: 40vh;
  overflow-y: auto;
}

.detail-line {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #4A5A50;
  line-height: 1.55;
}

.detail-dot {
  color: var(--color-primary);
  font-weight: 700;
}

.detail-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--green-100);
  color: var(--color-text-brand);
}

.detail-btn.primary {
  background: var(--color-primary);
  color: var(--color-bg-card);
  box-shadow: var(--shadow-brand);
}
