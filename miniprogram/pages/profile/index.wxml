<view class="page-profile page-safe-bottom tabbar-clear">
  <view class="profile-header {{loginState === 'guest' ? 'guest' : ''}}">
    <block wx:if="{{loginState === 'guest'}}">
      <view class="guest-header" hover-class="guest-header-hover" bindtap="goLogin">
        <view class="avatar avatar-placeholder guest"><view class="mi-glyph glyph-lg icon-user"></view></view>
        <view class="nickname">登录 / 注册</view>
        <view class="guest-login-tip">登录后记录学习数据 · 领取积分权益</view>
        <view class="guest-cta">立即登录</view>
      </view>
    </block>

    <block wx:elif="{{loginState === 'loading'}}">
      <view class="avatar avatar-placeholder"><text class="avatar-glyph">岛</text></view>
      <view class="nickname">加载中...</view>
    </block>

    <block wx:elif="{{loginState === 'ready' && user}}">
      <view class="header-gear" hover-class="header-gear-hover" bindtap="goEdit">
        <view class="gear-icon"></view>
      </view>
      <button class="avatar-picker inline" hover-class="none" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image
          wx:if="{{avatarDisplay}}"
          class="avatar"
          src="{{avatarDisplay}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar avatar-placeholder"><text class="avatar-glyph">岛</text></view>
      </button>
      <view class="nickname">{{user.nickname}}</view>
      <view class="title-badge">{{user.title || '小白'}}</view>

      <view class="edit-row" wx:if="{{avatarUploading}}">
        <view class="btn-outline small">头像更新中...</view>
      </view>
    </block>
  </view>

  <!-- 余额 / 积分 双入口卡（可点跳钱包/积分明细） -->
  <view class="asset-row" wx:if="{{loginState === 'ready' && user}}">
    <view class="asset-pill" hover-class="asset-pill-hover" bindtap="go" data-url="{{menuUrls.wallet}}">
      <view class="asset-val">¥{{user.balance}}</view>
      <view class="asset-key">余额 ›</view>
    </view>
    <view class="asset-pill" hover-class="asset-pill-hover" bindtap="go" data-url="{{menuUrls.points}}">
      <view class="asset-val">{{user.total_points}}</view>
      <view class="asset-key">积分 ›</view>
    </view>
  </view>

  <!-- 资料信息（学号 + 手机号），弱视觉存在 -->
  <view class="info-row" wx:if="{{loginState === 'ready' && user}}">
    <view class="info-item" bindtap="copyUserId">
      <text class="info-key">学号</text>
      <text class="info-val">#{{user.id}}</text>
      <text class="info-action">复制</text>
    </view>
    <view class="info-item" wx:if="{{user.phone}}">
      <text class="info-key">手机</text>
      <text class="info-val">{{user.phone}}</text>
    </view>
    <view class="info-item info-item--action" wx:else bindtap="goEdit">
      <text class="info-key">手机</text>
      <text class="info-val muted">未绑定</text>
      <text class="info-action">去绑定 ›</text>
    </view>
  </view>

  <view class="goal-card card" wx:if="{{loginState === 'ready' && user}}">
    <view class="goal-card-title">备考方向</view>
    <view class="goal-chips">
      <view
        wx:for="{{goalOptions}}"
        wx:key="value"
        class="goal-chip {{user.study_goal === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="saveStudyGoal"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="menu-sect-title">常用</view>
  <view class="menu-grid card">
    <view class="menu-item" hover-class="menu-item-hover" bindtap="go" data-url="{{menuUrls.wallet}}">
      <view class="menu-icon"><view class="mi-glyph icon-wallet"></view></view>
      <text>钱包</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="go" data-url="{{menuUrls.orders}}">
      <view class="menu-icon"><view class="mi-glyph icon-orders"></view></view>
      <text>我的订单</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="goPackages">
      <view class="menu-icon"><view class="mi-glyph icon-cards"></view></view>
      <text>我的期限卡</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="go" data-url="{{menuUrls.wrongbook}}">
      <view class="menu-icon"><view class="mi-glyph icon-book-open"></view></view>
      <text>错题本</text>
    </view>
  </view>

  <view class="menu-sect-title">更多</view>
  <view class="menu-grid card">
    <view class="menu-item" hover-class="menu-item-hover" bindtap="go" data-url="{{menuUrls.points}}">
      <view class="menu-icon"><view class="mi-glyph icon-points"></view></view>
      <text>积分明细</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="go" data-url="{{menuUrls.invite}}">
      <view class="menu-icon"><view class="mi-glyph icon-invite"></view></view>
      <text>邀请有礼</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="go" data-url="{{menuUrls.contact}}">
      <view class="menu-icon"><view class="mi-glyph icon-contact"></view></view>
      <text>联系店长</text>
    </view>
    <view class="menu-item" wx:if="{{showMarketplace}}" hover-class="menu-item-hover" bindtap="goMarket">
      <view class="menu-icon"><view class="mi-glyph icon-market"></view></view>
      <text>上岸集市</text>
    </view>
  </view>

  <view class="logout-row" wx:if="{{loginState === 'ready' && user}}">
    <view class="btn-logout" bindtap="doLogout">退出登录</view>
  </view>
</view>
