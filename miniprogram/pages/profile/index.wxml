<view class="page-profile page-safe-bottom tabbar-clear">
  <!-- 极净左对齐个人头部 -->
  <view class="profile-head">
    <block wx:if="{{loginState === 'guest'}}">
      <view class="user-row" bindtap="goLogin">
        <view class="avatar avatar-ph avatar-ph--guest">
          <view class="mi-glyph icon-user"></view>
        </view>
        <view class="user-info">
          <view class="user-name">登录 / 注册</view>
          <view class="user-sub">登录后同步自习数据与会员权益</view>
        </view>
        <view class="guest-pill">去登录</view>
      </view>
    </block>

    <block wx:elif="{{loginState === 'loading'}}">
      <view class="user-row">
        <view class="avatar avatar-ph">岛</view>
        <view class="user-info">
          <view class="user-name">加载中…</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{loginState === 'ready' && user}}">
      <view class="user-row">
        <button class="avatar-btn" hover-class="none" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarDisplay}}" class="avatar" src="{{avatarDisplay}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-ph">岛</view>
        </button>

        <view class="user-info">
          <view class="user-name-line">
            <view class="user-name">{{user.nickname}}</view>
            <view class="user-badge">{{user.title || '新同学'}}</view>
          </view>
          <view class="user-sub-row">
            <text class="user-sub-item" bindtap="copyUserId">学号 #{{user.id}}</text>
            <text class="user-sub-dot">·</text>
            <text class="user-sub-item" wx:if="{{phoneMasked}}">{{phoneMasked}}</text>
            <text class="user-sub-link" wx:else bindtap="goEdit">绑定手机号 ›</text>
          </view>
        </view>

        <view class="settings-btn" hover-class="settings-btn-hover" bindtap="goEdit" aria-role="button" aria-label="编辑资料与设置">
          <view class="mi-glyph icon-settings"></view>
        </view>
      </view>
    </block>
  </view>

  <!-- 统一会员资产卡 -->
  <view class="asset-card" wx:if="{{loginState === 'ready' && user}}">
    <view class="asset-col" hover-class="asset-col-hover" bindtap="go" data-url="{{menuUrls.wallet}}">
      <view class="asset-val">¥{{user.balance}}</view>
      <view class="asset-key">账户余额 ›</view>
    </view>
    <view class="asset-sep"></view>
    <view class="asset-col" hover-class="asset-col-hover" bindtap="go" data-url="{{menuUrls.points}}">
      <view class="asset-val">{{user.total_points}}</view>
      <view class="asset-key">自习积分 ›</view>
    </view>
  </view>

  <!-- 常用：清爽 4 宫格 -->
  <view class="panel-card">
    <view class="quick-grid">
      <view class="quick-item" hover-class="quick-item-hover" bindtap="go" data-url="{{menuUrls.orders}}">
        <view class="quick-icon-wrap"><view class="mi-glyph icon-orders"></view></view>
        <text class="quick-label">我的订单</text>
      </view>
      <view class="quick-item" hover-class="quick-item-hover" bindtap="goPackages">
        <view class="quick-icon-wrap"><view class="mi-glyph icon-cards"></view></view>
        <text class="quick-label">我的期限卡</text>
      </view>
      <view class="quick-item" hover-class="quick-item-hover" bindtap="go" data-url="{{menuUrls.coupons}}">
        <view class="quick-icon-wrap"><view class="mi-glyph icon-coupons"></view></view>
        <text class="quick-label">优惠券</text>
      </view>
      <view class="quick-item" hover-class="quick-item-hover" bindtap="go" data-url="{{menuUrls.messages}}">
        <view class="quick-icon-wrap quick-icon-wrap--msg">
          <view class="mi-glyph icon-bell"></view>
          <view class="msg-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
        <text class="quick-label">消息中心</text>
      </view>
    </view>
  </view>

  <!-- 更多服务：极简列表行 -->
  <view class="panel-card list-card">
    <view class="list-row" hover-class="list-row-hover" bindtap="go" data-url="{{menuUrls.wrongbook}}">
      <view class="mi-glyph icon-notebook list-icon"></view>
      <text class="list-label">错题本</text>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-row" hover-class="list-row-hover" bindtap="go" data-url="{{menuUrls.invite}}">
      <view class="mi-glyph icon-invite list-icon"></view>
      <text class="list-label">邀请有礼</text>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-row" hover-class="list-row-hover" bindtap="go" data-url="{{menuUrls.contact}}">
      <view class="mi-glyph icon-contact list-icon"></view>
      <text class="list-label">联系店长</text>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-row" wx:if="{{showMarketplace}}" hover-class="list-row-hover" bindtap="goMarket">
      <view class="mi-glyph icon-market list-icon"></view>
      <text class="list-label">上岸集市</text>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="legal-row">
    <text bindtap="openAgreement" data-type="user">《用户服务协议》</text>
    <text> · </text>
    <text bindtap="openAgreement" data-type="privacy">《隐私政策》</text>
  </view>
</view>
