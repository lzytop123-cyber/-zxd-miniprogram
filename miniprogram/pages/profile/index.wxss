.page-profile {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ============ 极净左对齐个人头部 ============ */
.profile-head {
  padding: 28rpx 32rpx 24rpx;
  background: #FFFFFF;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: block;
  background: #EEF3F0;
  border: 2rpx solid rgba(17, 24, 28, 0.06);
  box-sizing: border-box;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2D6A4F;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
}

.avatar-ph--guest {
  background: #DCE4DF;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #11181C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #2D6A4F;
  background: #EBF3EE;
}

.user-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.user-sub-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.user-sub-dot {
  opacity: 0.45;
}

.user-sub-link {
  color: #2D6A4F;
  font-weight: 600;
}

.guest-pill {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #2D6A4F;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.settings-btn-hover {
  background: #F2F4F3;
}

/* ============ 统一资产卡 ============ */
.asset-card {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 28rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(17, 24, 28, 0.05);
  box-shadow: var(--shadow-sm);
}

.asset-col {
  flex: 1;
  text-align: center;
  padding: 4rpx 16rpx;
}

.asset-col-hover {
  opacity: 0.7;
}

.asset-sep {
  width: 2rpx;
  height: 52rpx;
  background: rgba(17, 24, 28, 0.08);
  flex-shrink: 0;
}

.asset-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #11181C;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.asset-key {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ============ 通用白卡片 ============ */
.panel-card {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(17, 24, 28, 0.05);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 常用 4 宫格 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 28rpx 12rpx 24rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.quick-item-hover {
  opacity: 0.65;
}

.quick-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #F6F8F7;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.quick-label {
  font-size: 23rpx;
  color: #1C2B20;
  font-weight: 500;
}

.msg-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #D9483B;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 更多服务：极简列表行 */
.list-card {
  padding: 4rpx 0;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  position: relative;
}

.list-row + .list-row::before {
  content: '';
  position: absolute;
  left: 84rpx;
  right: 28rpx;
  top: 0;
  height: 1rpx;
  background: rgba(17, 24, 28, 0.06);
}

.list-row-hover {
  background: #F8FAF9;
}

.list-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.list-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #11181C;
}

.list-arrow {
  font-size: 32rpx;
  color: #B4C0BA;
  line-height: 1;
}

/* 协议页脚 */
.legal-row {
  margin-top: 36rpx;
  padding-bottom: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8C9BA5;
}
