.page-profile {
  min-height: 100vh;
  padding-bottom: 32rpx;
}

.login-loading {
  padding: 120rpx 32rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #8C9BA5;
}

.login-error {
  margin: 32rpx 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.login-error-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C2B20;
}

.login-error-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #E07A5F;
}

.login-retry {
  margin-top: 32rpx;
}

.login-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #8C9BA5;
  line-height: 1.6;
}

.setup-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.setup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C2B20;
}

.setup-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C9BA5;
  line-height: 1.5;
}

.avatar-picker {
  margin: 32rpx auto 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-picker::after {
  border: none;
}

.avatar-picker.inline {
  margin-top: 0;
}

.avatar-picker .avatar {
  display: block;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  background: #D8F3DC;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #2D6A4F;
  border-color: #52B788;
}

.setup-card .avatar {
  border-color: #52B788;
}

.avatar-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #52B788;
}

.nickname-field {
  margin-top: 32rpx;
  text-align: left;
}

.field-label {
  font-size: 24rpx;
  color: #8C9BA5;
  margin-bottom: 12rpx;
}

.nickname-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #F4FAF6;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1C2B20;
}

.setup-save {
  margin-top: 32rpx;
}

.setup-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8C9BA5;
}

.profile-header {
  position: relative;
  overflow: hidden;
  padding: 48rpx 32rpx 52rpx;
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
  color: #FFFFFF;
  background:
    radial-gradient(circle 260rpx at 92% -40rpx, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0) 100%),
    linear-gradient(160deg, #2D6A4F 0%, #43976B 55%, #52B788 100%);
}

/* 分组小标题 */
.menu-sect-title {
  margin: 24rpx 32rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8C9BA5;
}

.header-gear {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  z-index: 2;
}

.header-gear-hover {
  background: rgba(255, 255, 255, 0.28);
}

.gear-icon {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'24'%20height%3D'24'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'%23fff'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Ccircle%20cx%3D'12'%20cy%3D'12'%20r%3D'3'%2F%3E%3Cpath%20d%3D'M19.4%2015a1.65%201.65%200%200%200%20.33%201.82l.06.06a2%202%200%201%201-2.83%202.83l-.06-.06a1.65%201.65%200%200%200-1.82-.33%201.65%201.65%200%200%200-1%201.51V21a2%202%200%200%201-4%200v-.09A1.65%201.65%200%200%200%209%2019.4a1.65%201.65%200%200%200-1.82.33l-.06.06a2%202%200%201%201-2.83-2.83l.06-.06a1.65%201.65%200%200%200%20.33-1.82%201.65%201.65%200%200%200-1.51-1H3a2%202%200%200%201%200-4h.09A1.65%201.65%200%200%200%204.6%209a1.65%201.65%200%200%200-.33-1.82l-.06-.06a2%202%200%201%201%202.83-2.83l.06.06a1.65%201.65%200%200%200%201.82.33H9a1.65%201.65%200%200%200%201-1.51V3a2%202%200%200%201%204%200v.09a1.65%201.65%200%200%200%201%201.51%201.65%201.65%200%200%200%201.82-.33l.06-.06a2%202%200%201%201%202.83%202.83l-.06.06a1.65%201.65%200%200%200-.33%201.82V9a1.65%201.65%200%200%200%201.51%201H21a2%202%200%200%201%200%204h-.09a1.65%201.65%200%200%200-1.51%201z'%2F%3E%3C%2Fsvg%3E");
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.title-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  font-size: 24rpx;
}

.phone-line {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.phone-line.muted {
  opacity: 0.75;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 32rpx;
}

.stat-pill {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 20rpx 40rpx;
  min-width: 160rpx;
}

.stat-val {
  font-size: 32rpx;
  font-weight: 700;
}

.stat-key {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.edit-row {
  margin-top: 20rpx;
}

.btn-outline.small {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  border-radius: 40rpx;
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin: 0 24rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 16rpx;
  font-size: 26rpx;
  color: #1C2B20;
  transition: background 0.15s ease;
}

.menu-grid .menu-item:nth-child(-n + 2) {
  border-bottom: 2rpx solid #EEF4F0;
}

.menu-item:nth-child(odd) {
  border-right: 2rpx solid #EEF4F0;
}

.menu-item-hover {
  background: #F4FAF6;
}

.menu-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.mi-glyph {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.glyph-lg {
  width: 60rpx;
  height: 60rpx;
}

.phone-btn {
  background: transparent;
  line-height: normal;
  font-weight: normal;
}

.phone-btn::after {
  border: none;
}

.profile-header.guest {
  padding-bottom: 48rpx;
}

.guest-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.guest-header-hover {
  opacity: 0.92;
}

.avatar.guest {
  border-color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.15);
}

.guest-login-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.guest-cta {
  margin-top: 28rpx;
  padding: 16rpx 56rpx;
  background: #FFFFFF;
  color: #2D6A4F;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.guest-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.guest-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #8C9BA5;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
}

.guest-info {
  flex: 1;
  min-width: 0;
}

.guest-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C2B20;
}

.guest-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C9BA5;
}

.guest-arrow {
  font-size: 40rpx;
  color: #CFD8DC;
  flex-shrink: 0;
}

.goal-field {
  margin-top: 28rpx;
  text-align: left;
}

.goal-card {
  margin: 24rpx;
  padding: 28rpx 32rpx;
}

.goal-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C2B20;
}

.goal-card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C9BA5;
}

.goal-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.goal-chip {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2D6A4F;
  background: #E8F5E9;
  border: 2rpx solid transparent;
}

.goal-chip.active {
  background: #2D6A4F;
  color: #fff;
}

.goal-current {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #52B788;
}

.id-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.id-val {
  font-weight: 700;
  letter-spacing: 1rpx;
}

.id-copy {
  opacity: 0.8;
  font-size: 22rpx;
  padding-left: 8rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.35);
}

.logout-row {
  margin: 8rpx 24rpx 32rpx;
  text-align: center;
}

.btn-logout {
  display: inline-block;
  padding: 20rpx 48rpx;
  font-size: 26rpx;
  color: #8C9BA5;
}

