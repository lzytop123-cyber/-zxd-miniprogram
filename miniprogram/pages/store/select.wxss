.store-select-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-page);
}

.location-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-text-brand);
  font-size: var(--font-base);
}

.location-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
}

.location-copy {
  flex: 1;
}

.location-action {
  flex: none;
  font-weight: 600;
}

.list-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 8rpx 20rpx;
  color: var(--color-text);
  font-size: var(--font-lg);
  font-weight: 700;
}

.list-heading text {
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  font-weight: 400;
}

.loading-card {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}

.loading-cover,
.loading-line {
  background: var(--color-bg-sunken);
}

.loading-cover {
  width: 232rpx;
  height: 236rpx;
  border-radius: var(--radius-md);
}

.loading-lines {
  flex: 1;
  padding-top: 12rpx;
}

.loading-line {
  height: 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-sm);
}

.loading-line--title {
  width: 72%;
  height: 32rpx;
}

.loading-line--short {
  width: 48%;
}

.state {
  margin-top: 64rpx;
  padding: 48rpx 32rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  text-align: center;
}

.state-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.state-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

.retry-button {
  width: 240rpx;
  margin-top: 32rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-primary-fg);
  font-size: var(--font-md);
}
