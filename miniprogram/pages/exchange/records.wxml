<view class="list-page page-safe-bottom">
  <view class="empty" wx:if="{{loading}}">
    <view>正在加载…</view>
  </view>
  <view class="empty" wx:elif="{{loadError && !records.length}}">
    <view class="mi-glyph glyph-xl icon-orders empty-glyph"></view>
    <view>{{loadError}}</view>
    <view class="btn-primary" style="margin-top:24rpx;" bindtap="retryLoad">重新加载</view>
  </view>
  <block wx:else>
    <view class="card item-card" wx:for="{{records}}" wx:key="id">
      <view class="item-head">
        <view class="name">{{item.deal_name || '团购兑换'}}</view>
        <view class="status-pill">{{item.status === 'verified' ? '已核销' : item.status}}</view>
      </view>
      <view class="info" wx:if="{{item.validityText}}">{{item.validityText}}</view>
      <view class="info">券码 {{item.coupon_code}}</view>
      <view class="info" wx:if="{{item.verified_at}}">{{item.verified_at}}</view>
    </view>
    <view class="empty" wx:if="{{!records.length}}">
      <view class="mi-glyph glyph-xl icon-leaf empty-glyph"></view>
      <view>暂无兑换记录</view>
    </view>
  </block>
</view>
