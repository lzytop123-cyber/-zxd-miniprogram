.page-exchange {
  min-height: 100vh;
}

.exchange-card {
  margin-top: 32rpx;
}

.store-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--color-primary-soft);
}

.store-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.store-pin {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.store-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-name-warn {
  color: #b45309;
}

.store-switch {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.platform-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: var(--color-bg-page);
}

.platform-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.platform-tab.active {
  background: var(--color-bg-card);
  color: var(--color-text-brand);
  box-shadow: var(--shadow-brand-soft);
}

.platform-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.platform-dot--meituan {
  background: #FFBD00;
}

.platform-dot--douyin {
  background: #161823;
}

.code-field {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-primary-soft);
  border-radius: 18rpx;
  margin: 8rpx 0 14rpx;
  background: var(--color-bg-page);
  overflow: hidden;
}

.code-input {
  flex: 1;
  min-width: 0;
  padding: 24rpx 8rpx 24rpx 24rpx;
  font-size: 30rpx;
  background: transparent;
}

.code-clear {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: rgba(61, 82, 69, 0.12);
  color: var(--color-text-secondary);
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
  flex-shrink: 0;
}

.code-paste {
  padding: 8rpx 18rpx;
  margin-right: 10rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(45, 106, 79, 0.08);
  flex-shrink: 0;
}

.code-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-left: 2rpx solid var(--color-primary-soft);
  background: rgba(255, 255, 255, 0.65);
}

.code-scan.disabled {
  opacity: 0.45;
}

.code-tip {
  font-size: 23rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
  padding-left: 4rpx;
}

.link-records {
  text-align: center;
  color: var(--color-primary);
  font-size: 26rpx;
  margin-top: 24rpx;
  font-weight: 600;
}
