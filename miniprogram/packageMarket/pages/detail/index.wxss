.page { padding-bottom: 160rpx; }
.swiper { height: 520rpx; background: var(--color-bg-sunken); }
.slide { width: 100%; height: 520rpx; }
.card {
  margin: 24rpx; background: var(--color-bg-card); border-radius: 28rpx; padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.title { font-size: 34rpx; font-weight: 700; color: var(--color-text); }
.price { margin-top: 12rpx; color: var(--color-text-brand); font-size: 36rpx; font-weight: 700; }
.meta { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.reject {
  margin-top: 16rpx; padding: 16rpx 20rpx; background: #FFF1F0; color: var(--color-danger);
  border-radius: 16rpx; font-size: 24rpx; line-height: 1.5;
}
.desc { margin-top: 20rpx; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.seller-row { display: flex; gap: 16rpx; align-items: center; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--color-primary-soft); }
.avatar.ph { display:flex;align-items:center;justify-content:center;color:var(--color-text-brand);font-weight:700; }
.seller-name { font-weight: 600; }
.hint { margin-top: 16rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.contact-box {
  margin-top: 16rpx; padding: 20rpx; background: var(--color-bg-page); border-radius: 16rpx;
}
.contact-label { color: var(--color-text-secondary); font-size: 22rpx; }
.contact-value {
  margin: 8rpx 0 12rpx; font-size: 34rpx; font-weight: 700; color: var(--color-text-brand);
  word-break: break-all;
}
.contact-copy { height: 64rpx; line-height: 64rpx; font-size: 26rpx; }
.section-title { padding: 8rpx 32rpx; font-weight: 600; color: var(--color-text-brand); }
.similar { display: flex; gap: 16rpx; overflow-x: auto; padding: 8rpx 24rpx 24rpx; }
.sim-card { width: 220rpx; background: var(--color-bg-card); border-radius: 20rpx; padding: 12rpx; flex-shrink: 0; }
.sim-cover { width: 100%; height: 160rpx; border-radius: 16rpx; background: var(--color-bg-sunken); }
.sim-title { font-size: 24rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sim-price { color: var(--color-text-brand); font-weight: 600; font-size: 24rpx; }
.bottom {
  position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--color-bg-card);
  box-shadow: var(--shadow-inset-top);
}
.btn {
  flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: 24rpx; font-weight: 600;
}
.btn.primary { background: var(--color-primary); color: var(--color-bg-card); }
.btn.ghost { background: var(--color-primary-soft); color: var(--color-text-brand); }
