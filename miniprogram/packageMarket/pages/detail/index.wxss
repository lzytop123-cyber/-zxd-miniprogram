.page { padding-bottom: 160rpx; }
.swiper { height: 520rpx; background: #E8ECEA; }
.slide { width: 100%; height: 520rpx; }
.card {
  margin: 24rpx; background: #fff; border-radius: 28rpx; padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(28,43,32,.06);
}
.title { font-size: 34rpx; font-weight: 700; color: #1C2B20; }
.price { margin-top: 12rpx; color: #2D6A4F; font-size: 36rpx; font-weight: 700; }
.meta { margin-top: 10rpx; color: #8C9BA5; font-size: 24rpx; }
.reject {
  margin-top: 16rpx; padding: 16rpx 20rpx; background: #FFF1F0; color: #C95C5C;
  border-radius: 12rpx; font-size: 24rpx; line-height: 1.5;
}
.desc { margin-top: 20rpx; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.seller-row { display: flex; gap: 16rpx; align-items: center; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #D8F3DC; }
.avatar.ph { display:flex;align-items:center;justify-content:center;color:#2D6A4F;font-weight:700; }
.seller-name { font-weight: 600; }
.hint { margin-top: 16rpx; color: #8C9BA5; font-size: 22rpx; }
.section-title { padding: 8rpx 32rpx; font-weight: 600; color: #2D6A4F; }
.similar { display: flex; gap: 16rpx; overflow-x: auto; padding: 8rpx 24rpx 24rpx; }
.sim-card { width: 220rpx; background: #fff; border-radius: 20rpx; padding: 12rpx; flex-shrink: 0; }
.sim-cover { width: 100%; height: 160rpx; border-radius: 16rpx; background: #E8ECEA; }
.sim-title { font-size: 24rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sim-price { color: #2D6A4F; font-weight: 600; font-size: 24rpx; }
.bottom {
  position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(28,43,32,.06);
}
.btn {
  flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: 24rpx; font-weight: 600;
}
.btn.primary { background: #52B788; color: #fff; }
.btn.ghost { background: #D8F3DC; color: #2D6A4F; }
