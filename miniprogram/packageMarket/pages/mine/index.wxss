.page { padding-bottom: 48rpx; }
.top-actions { display: flex; gap: 16rpx; margin: 24rpx; }
.btn {
  flex: 1; text-align: center; height: 80rpx; line-height: 80rpx;
  background: var(--color-primary); color: var(--color-bg-card); border-radius: 20rpx; font-weight: 600;
}
.btn.ghost { background: var(--color-primary-soft); color: var(--color-text-brand); }
.tabs { display: flex; margin: 0 24rpx 16rpx; background: var(--color-bg-card); border-radius: 20rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; color: var(--color-text-secondary); }
.tab.on { color: var(--color-text-brand); font-weight: 700; background: var(--color-primary-soft); }
.card {
  margin: 0 24rpx 16rpx; background: var(--color-bg-card); border-radius: 24rpx; padding: 24rpx;
  box-shadow: var(--shadow-sm);
}
.title { font-weight: 600; }
.meta { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.reject { margin-top: 10rpx; color: var(--color-danger); font-size: 24rpx; line-height: 1.4; }
.empty { text-align: center; color: var(--color-text-secondary); padding: 80rpx 24rpx; }
