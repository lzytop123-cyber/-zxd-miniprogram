.page { padding-bottom: 48rpx; }
.search-bar {
  margin: 24rpx;
  display: flex;
  gap: 16rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  box-shadow: var(--shadow-sm);
}
.search-input { flex: 1; height: 72rpx; font-size: 28rpx; }
.search-btn {
  background: var(--color-primary); color: var(--color-bg-card); border-radius: 20rpx;
  padding: 0 28rpx; line-height: 72rpx; font-weight: 600;
}
.mine-link {
  margin: 0 32rpx 8rpx; text-align: right; color: var(--color-text-brand);
  font-size: 26rpx; font-weight: 600;
}
.section-title { padding: 24rpx 32rpx 8rpx; font-size: 30rpx; font-weight: 600; color: var(--color-text-brand); }
.section-row {
  display: flex; justify-content: space-between; align-items: center; padding-right: 32rpx;
}
.section-links { display: flex; align-items: center; gap: 24rpx; }
.link { color: var(--color-primary); font-size: 24rpx; font-weight: 600; }
.more { color: var(--color-text-secondary); font-size: 24rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 8rpx 24rpx 16rpx; }
.chip {
  background: var(--color-bg-card); color: var(--color-text-brand); padding: 12rpx 28rpx; border-radius: 40rpx;
  font-size: 24rpx; box-shadow: var(--shadow-sm);
}
.chip.active { background: var(--color-primary); color: var(--color-bg-card); }
.list { padding: 0 24rpx; }
.card {
  display: flex; gap: 20rpx; background: var(--color-bg-card); border-radius: 28rpx;
  padding: 20rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
}
.cover { width: 160rpx; height: 160rpx; border-radius: 20rpx; background: var(--color-bg-sunken); flex-shrink: 0; }
.cover.ph { display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: 22rpx; }
.body { flex: 1; min-width: 0; }
.title { font-size: 28rpx; font-weight: 600; color: var(--color-text); }
.meta { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.price { margin-top: 16rpx; color: var(--color-text-brand); font-weight: 700; font-size: 30rpx; }
.empty { text-align: center; color: var(--color-text-secondary); padding: 80rpx 24rpx; }
.empty-btn {
  display: inline-block; margin-top: 24rpx; padding: 16rpx 40rpx;
  background: var(--color-primary); color: var(--color-bg-card); border-radius: 40rpx; font-weight: 600;
}
.footer-tip { text-align: center; color: var(--color-text-secondary); font-size: 22rpx; padding: 16rpx 0 8rpx; }
