<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索资料标题" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="goSearch" />
    <view class="search-btn" bindtap="goSearch">搜索</view>
  </view>

  <view class="mine-link" bindtap="goMine">我的集市 ›</view>

  <view class="section-title">考试分类</view>
  <view class="chips">
    <view
      class="chip {{exam_category_id==item.id ? 'active' : ''}}"
      wx:for="{{examCategories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goExam"
    >{{item.name}}</view>
  </view>

  <view class="section-title">资料类型</view>
  <view class="chips">
    <view
      class="chip {{material_category_id==item.id ? 'active' : ''}}"
      wx:for="{{materialCategories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goMaterial"
    >{{item.name}}</view>
  </view>

  <view class="section-row">
    <view class="section-title">{{filtered ? '筛选结果' : '最新发布'}}</view>
    <view class="section-links">
      <text class="link" bindtap="goPublish">发布</text>
      <text class="more" wx:if="{{filtered}}" bindtap="clearFilters">清除筛选</text>
    </view>
  </view>

  <view class="list" wx:if="{{latest.length}}">
    <view class="card" wx:for="{{latest}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image class="cover" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}" />
      <view class="cover ph" wx:else>暂无图</view>
      <view class="body">
        <view class="title">{{item.title}}</view>
        <view class="meta">{{item.exam_category_name}} · {{item.material_category_name}}</view>
        <view class="price">{{item.priceText}}</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:elif="{{!loading}}">
    <view>{{filtered ? '没有符合条件的发布' : '暂无发布'}}</view>
    <view class="empty-btn" wx:if="{{filtered}}" bindtap="clearFilters">清除筛选</view>
    <view class="empty-btn" wx:else bindtap="goPublish">去发布第一条</view>
  </view>
  <view class="footer-tip" wx:if="{{loading}}">加载中…</view>
  <view class="footer-tip" wx:elif="{{finished && latest.length}}">没有更多了</view>
</view>
