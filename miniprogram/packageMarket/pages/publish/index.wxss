.page { padding-bottom: 48rpx; }
.card {
  margin: 24rpx; background: var(--color-bg-card); border-radius: 28rpx; padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.label { margin-top: 20rpx; margin-bottom: 10rpx; color: var(--color-text-brand); font-weight: 600; font-size: 24rpx; }
.label:first-child { margin-top: 0; }
.picker, .input {
  background: var(--color-bg-page); border-radius: 16rpx; padding: 20rpx 24rpx; min-height: 88rpx;
  box-sizing: border-box; width: 100%;
}
.textarea {
  background: var(--color-bg-page); border-radius: 16rpx; padding: 20rpx 24rpx; width: 100%;
  min-height: 200rpx; box-sizing: border-box;
}
.images { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-wrap { position: relative; width: 160rpx; height: 160rpx; }
.img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--color-bg-sunken); }
.del {
  position: absolute; right: -8rpx; top: -8rpx; width: 40rpx; height: 40rpx;
  border-radius: 50%; background: var(--color-danger); color: var(--color-bg-card); text-align: center; line-height: 36rpx;
}
.add {
  width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--color-bg-page);
  color: var(--color-text-secondary); font-size: 64rpx; display: flex; align-items: center; justify-content: center;
}
.check { display: flex; gap: 12rpx; margin-top: 24rpx; font-size: 24rpx; color: #6F7D73; line-height: 1.65; align-items: flex-start; }
.check checkbox { margin-top: 4rpx; flex-shrink: 0; }
.check-text { flex: 1; }
.agree-link { color: var(--color-text-brand); font-weight: 600; }
.btns { display: flex; gap: 16rpx; margin: 24rpx; }
.btn {
  flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: 24rpx; font-weight: 600;
}
.btn.primary { background: var(--color-primary); color: var(--color-bg-card); }
.btn.ghost { background: var(--color-primary-soft); color: var(--color-text-brand); }
