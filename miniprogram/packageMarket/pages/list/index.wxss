.page { padding-bottom: 48rpx; }
.filters { display: flex; gap: 12rpx; padding: 20rpx 24rpx; flex-wrap: wrap; }
.filter {
  background: var(--color-bg-card); padding: 12rpx 24rpx; border-radius: 40rpx; font-size: 24rpx; color: var(--color-text-brand);
}
.filter.on { background: var(--color-primary-soft); font-weight: 600; }
.list { padding: 0 24rpx; }
.card {
  display: flex; gap: 20rpx; background: var(--color-bg-card); border-radius: 28rpx;
  padding: 20rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
}
.cover { width: 160rpx; height: 160rpx; border-radius: 20rpx; background: var(--color-bg-sunken); flex-shrink: 0; }
.cover.ph { display:flex;align-items:center;justify-content:center;color:var(--color-text-secondary);font-size:22rpx; }
.body { flex: 1; min-width: 0; }
.title { font-size: 28rpx; font-weight: 600; }
.meta { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.price { margin-top: 16rpx; color: var(--color-text-brand); font-weight: 700; font-size: 30rpx; }
.empty, .tip { text-align: center; color: var(--color-text-secondary); padding: 40rpx; }
