.page-agreement {
  min-height: 100vh;
  padding: 32rpx 36rpx 80rpx;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 12rpx;
}

.doc-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 36rpx;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-brand);
  margin-bottom: 16rpx;
}

.para {
  font-size: 28rpx;
  color: #3D4F44;
  line-height: 1.75;
  margin-bottom: 16rpx;
  text-align: justify;
}
