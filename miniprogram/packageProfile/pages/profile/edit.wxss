.page-edit {
  min-height: 100vh;
  background: #F4FAF6;
}

.edit-loading {
  padding: 160rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8C9BA5;
}

.setup-card {
  margin: 24rpx 32rpx 0;
  text-align: center;
}

.setup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C2B20;
}

.setup-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C9BA5;
  line-height: 1.5;
}

.avatar-picker {
  margin: 32rpx auto 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: visible;
}

.avatar-picker .avatar {
  display: block;
}

.avatar-picker::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #52B788;
  background: #D8F3DC;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
  color: #2D6A4F;
}

.avatar-placeholder--add {
  box-sizing: border-box;
  border-style: dashed;
  background: #F4FAF6;
  font-size: 64rpx;
  font-weight: 300;
  color: #52B788;
}

.avatar-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #52B788;
  text-align: center;
  padding: 0 24rpx;
  line-height: 1.5;
}

.nickname-field,
.phone-field,
.goal-field {
  margin-top: 28rpx;
  text-align: left;
}

.phone-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  margin: 0;
  background: #F4FAF6;
  border-radius: 16rpx;
  line-height: normal;
}

.phone-btn::after {
  border: none;
}

.phone-value {
  font-size: 28rpx;
  color: #1C2B20;
}

.phone-value.muted {
  color: #8C9BA5;
}

.phone-action {
  font-size: 26rpx;
  color: #2D6A4F;
  font-weight: 600;
}

.field-label {
  font-size: 24rpx;
  color: #8C9BA5;
  margin-bottom: 12rpx;
}

.nickname-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #F4FAF6;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1C2B20;
}

.goal-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.goal-chip {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2D6A4F;
  background: #E8F5E9;
}

.goal-chip.active {
  background: #2D6A4F;
  color: #fff;
}

.setup-save {
  margin-top: 32rpx;
}

.setup-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8C9BA5;
}
