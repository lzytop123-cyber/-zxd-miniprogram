<view class="page">
  <view class="header" wx:if="{{list.length > 0}}">
    <text class="hint">共 {{list.length}} 条消息</text>
    <text class="mark-all" bindtap="markAllRead">全部标为已读</text>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-title">暂无消息</text>
    <text class="empty-desc">系统通知、活动、到期提醒会显示在这里</text>
  </view>

  <view class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="msg-item {{!item.is_read ? 'unread' : ''}}"
      data-id="{{item.id}}"
      data-link="{{item.link_path}}"
      bindtap="onTap"
      hover-class="msg-item-hover"
    >
      <view class="msg-head">
        <view class="title-wrap">
          <view wx:if="{{!item.is_read}}" class="dot"></view>
          <text class="title">{{item.title}}</text>
        </view>
        <text class="cat cat-{{item.category}}">
          {{item.category === 'system' ? '系统' : item.category === 'reminder' ? '提醒' : '活动'}}
        </text>
      </view>
      <text class="content">{{item.content}}</text>
      <view class="foot">
        <text class="time">{{item.created_at}}</text>
        <text wx:if="{{item.link_path}}" class="cta">查看详情 ›</text>
      </view>
    </view>
  </view>
</view>
