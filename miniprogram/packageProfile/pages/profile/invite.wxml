<view class="list-page page-safe-bottom">
  <view class="card">
    <view class="label">我的邀请码</view>
    <view class="code-row">
      <text class="code">{{inviteCode || '加载中...'}}</text>
      <view class="copy-btn" bindtap="copyCode">复制</view>
    </view>
    <view class="hint">好友填写您的邀请码，您得 50 积分，好友得 20 积分</view>
    <button class="btn-primary share-btn" open-type="share" disabled="{{!inviteCode}}">发给好友</button>
  </view>

  <view class="card" wx:if="{{!hasAppliedInvite}}">
    <view class="label">填写好友邀请码</view>
    <input class="input" placeholder="请输入邀请码" value="{{inputCode}}" bindinput="onInput" />
    <view class="btn-primary" bindtap="submit">领取 20 积分</view>
  </view>
  <view class="card" wx:else>
    <view class="label">好友邀请福利</view>
    <view class="hint" style="margin-bottom:0;">您已绑定过好友邀请码并领取新手积分奖励</view>
  </view>

  <view class="card">
    <view class="section-head">已成功邀请（{{inviteCount}} 人）</view>
    <view class="log" wx:for="{{records}}" wx:key="id">
      <view>
        <view>{{item.nickname}}</view>
        <view class="time">{{item.created_at}}</view>
      </view>
      <view class="pts">+{{item.reward_points}} 积分</view>
    </view>
    <view class="empty" wx:if="{{!records.length}}">
      <view class="empty-icon">🌱</view>
      <view>暂未邀请好友，快转发给同桌吧</view>
    </view>
  </view>
</view>
