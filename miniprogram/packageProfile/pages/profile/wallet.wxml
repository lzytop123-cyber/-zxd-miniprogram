<view class="list-page page-safe-bottom">
  <view class="wallet-hero">
    <view class="balance-label">当前余额</view>
    <view class="balance-val">¥{{balance}}</view>
  </view>

  <view class="card">
    <view class="section-head">选择充值金额</view>
    <view class="amounts">
      <view class="amt {{amount==50?'active':''}}" bindtap="setAmount" data-a="50">50元</view>
      <view class="amt {{amount==100?'active':''}}" bindtap="setAmount" data-a="100">100元</view>
      <view class="amt {{amount==200?'active':''}}" bindtap="setAmount" data-a="200">200元</view>
      <view class="amt {{amount==500?'active':''}}" bindtap="setAmount" data-a="500">500元</view>
    </view>
    <view class="btn-primary" bindtap="recharge">立即充值</view>
  </view>

  <view class="card">
    <view class="section-head">账单明细</view>
    <view style="margin-bottom: 16rpx;">
      <view class="chip {{filter==='all'?'active':''}}" bindtap="setFilter" data-filter="all">全部</view>
      <view class="chip {{filter==='recharge'?'active':''}}" bindtap="setFilter" data-filter="recharge">充值</view>
      <view class="chip {{filter==='consume'?'active':''}}" bindtap="setFilter" data-filter="consume">消费与退款</view>
    </view>
    <view class="log" wx:for="{{logs}}" wx:key="id">
      <view>
        <view>{{item.remark}}</view>
        <view class="time" wx:if="{{item.created_at}}">{{item.created_at}}<text wx:if="{{item.balance_after != null}}"> · 余额 ¥{{item.balance_after}}</text></view>
      </view>
      <view class="log-amt" style="{{item.isPlus ? '' : 'color: #E07A5F;'}}">{{item.amountText}}</view>
    </view>
    <view class="empty" wx:if="{{!logs.length}}">
      <view class="empty-icon">💰</view>
      <view>暂无账单记录</view>
    </view>
  </view>
</view>
