.orders-page {
  min-height: 100vh;
  padding-bottom: 32rpx;
}

.order-card {
  margin-bottom: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-store {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-active {
  background: var(--color-primary-soft);
  color: var(--color-text-brand);
}

.status-booked {
  background: #E3F2FD;
  color: #1565C0;
}

.status-warn {
  background: var(--color-warning-bg);
  color: var(--color-warning-fg);
}

.status-done {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.status-muted {
  background: var(--color-border);
  color: var(--color-text-secondary);
}

.order-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-usage {
  background: var(--green-100);
  color: var(--color-text-brand);
}

.tag-zone {
  background: var(--color-bg-page);
  color: #5A6B62;
}

.zone-immersion {
  background: #EDE7F6;
  color: #5E35B1;
}

.zone-workspace {
  background: #E3F2FD;
  color: #1565C0;
}

.zone-standard {
  background: #FFF3E0;
  color: #E65100;
}

.order-meta {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg-page);
  border-radius: 16rpx;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.meta-row + .meta-row {
  margin-top: 10rpx;
}

.meta-label {
  flex-shrink: 0;
  width: 72rpx;
  color: var(--color-text-secondary);
}

.meta-value {
  flex: 1;
  min-width: 0;
  color: #2D3436;
  word-break: break-all;
}

.meta-price {
  font-weight: 700;
  color: var(--color-text-brand);
}

.source-meituan {
  color: #E65100;
  font-weight: 600;
}

.source-douyin {
  color: #111;
  font-weight: 600;
}

.source-wechat {
  color: #07C160;
  font-weight: 600;
}

.source-balance {
  color: #1565C0;
  font-weight: 600;
}

.source-card {
  color: var(--color-text-brand);
  font-weight: 600;
}

.source-pending {
  color: var(--color-warning-fg);
  font-weight: 600;
}

.order-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  line-height: 1.5;
}

.order-action {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-bg-page);
}

.action-btn {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-bg-card);
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn.ghost {
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  border: 2rpx solid #E3E8E5;
}

.orders-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
}

.orders-error .empty-title,
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
  padding: 0 16rpx;
}

.empty-desc + .empty-desc {
  margin-top: 12rpx;
}

.orders-login-btn {
  margin-top: 28rpx;
  display: inline-block;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}
