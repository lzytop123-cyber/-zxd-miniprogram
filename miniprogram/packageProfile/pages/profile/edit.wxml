<view class="page-edit page-safe-bottom">
  <view wx:if="{{loading}}" class="edit-loading">加载中...</view>

  <view wx:else class="setup-card card">
    <view class="setup-title">编辑资料</view>
    <view class="setup-desc">完善头像、昵称与备考方向</view>

    <button
      class="avatar-picker"
      hover-class="none"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      disabled="{{avatarUploading}}"
    >
      <image
        wx:if="{{avatarDisplay}}"
        class="avatar"
        src="{{avatarDisplay}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar avatar-placeholder avatar-placeholder--add">+</view>
    </button>
    <view class="avatar-tip">{{avatarUploading ? '同步中…' : '点击更换头像'}}</view>

    <view class="nickname-field">
      <view class="field-label">昵称</view>
      <input
        type="nickname"
        class="nickname-input"
        placeholder="输入昵称"
        value="{{draftNickname}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
      />
    </view>

    <view class="phone-field">
      <view class="field-label">手机号</view>
      <button
        class="phone-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
      >
        <text class="phone-value {{phoneMasked ? '' : 'muted'}}">{{phoneMasked || '未绑定'}}</text>
        <text class="phone-action">{{phoneMasked ? '更换' : '绑定'}}</text>
      </button>
    </view>

    <view class="goal-field">
      <view class="field-label">备考方向</view>
      <view class="goal-chips">
        <view
          wx:for="{{goalOptions}}"
          wx:key="value"
          class="goal-chip {{draftStudyGoal === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onGoalSelect"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="btn-primary setup-save" bindtap="saveProfile">保存</view>
    <view class="setup-note">学号 #{{user.id}}</view>
  </view>
</view>
