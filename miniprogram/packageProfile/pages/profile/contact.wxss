.page-contact {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
  background: var(--color-bg-page);
}

.hint {
  text-align: center;
  font-size: 26rpx;
  color: #3D5245;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.poster-wrap {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-brand-soft);
}

.poster {
  display: block;
  width: 100%;
  vertical-align: top;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 0 12rpx;
}

.tip-warn {
  color: var(--color-warning-fg);
  background: #FFF8E8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  text-align: left;
}

.save-btn {
  margin: 28rpx auto 0;
  width: 420rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-brand);
  background: var(--green-100);
  border-radius: 999rpx;
  font-weight: 600;
}
