.page-contact {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
  background: var(--color-bg-page);
}

.store-panel, .contact-card {
  padding: 32rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}
.store-label, .store-address { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.6; }
.store-choice { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 20rpx 0; font-size: 32rpx; font-weight: 600; color: var(--color-text); }
.store-switch { flex-shrink: 0; font-size: 24rpx; color: var(--color-text-brand); }
.location-row { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.location-row text { flex: 1; }
.location-button { flex-shrink: 0; margin: 0; padding: 12rpx; font-size: 24rpx; line-height: 1.5; color: var(--color-text-brand); background: transparent; }
.location-button::after, .save-btn::after { border: none; }
.contact-title { font-size: 30rpx; font-weight: 600; text-align: center; margin-bottom: 16rpx; color: var(--color-text); }
.contact-state { padding: 48rpx 0; text-align: center; color: var(--color-text-secondary); font-size: 28rpx; line-height: 1.6; }

.hint {
  text-align: center;
  font-size: 26rpx;
  color: #3D5245;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.poster-wrap {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-brand-soft);
}

.poster {
  display: block;
  width: 100%;
  vertical-align: top;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 0 12rpx;
}

.tip-warn {
  color: var(--color-warning-fg);
  background: #FFF8E8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  text-align: left;
}

.save-btn {
  margin: 28rpx auto 0;
  width: 420rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-brand);
  background: var(--green-100);
  border-radius: 999rpx;
  font-weight: 600;
}
