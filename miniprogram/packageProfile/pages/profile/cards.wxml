<view class="cards-page page-safe-bottom">
  <view class="cards-hero">
    <view class="hero-main">
      <view class="hero-count">{{activeCount}}</view>
      <view class="hero-label">可用期限卡</view>
    </view>
    <view class="hero-actions">
      <view class="hero-btn primary" bindtap="goBuy">直接购买</view>
      <view class="hero-btn" bindtap="goExchange">团购验券</view>
      <view class="hero-btn" bindtap="goExchangeRecords">验券记录</view>
    </view>
  </view>

  <view style="padding: 0 24rpx 20rpx; display: flex; gap: 16rpx;">
    <view class="chip {{tab==='active'?'active':''}}" bindtap="switchTab" data-tab="active">可用 ({{activeCount}})</view>
    <view class="chip {{tab==='history'?'active':''}}" bindtap="switchTab" data-tab="history">已使用 / 已过期 ({{historyCount}})</view>
  </view>

  <view class="cards-empty" wx:if="{{loading}}">
    <view class="empty-title">正在加载期限卡…</view>
  </view>

  <view class="cards-empty" wx:elif="{{loadError && !cards.length}}">
    <view class="empty-icon">⚠️</view>
    <view class="empty-title">加载失败</view>
    <view class="empty-desc">{{loadError}}</view>
    <view class="empty-actions">
      <view class="empty-btn primary" bindtap="retryLoad">重新加载</view>
    </view>
  </view>

  <view class="cards-list" wx:elif="{{cards.length}}">
    <view class="ticket-card ticket-{{item.card_type}}" style="{{tab==='history'?'opacity:0.68;filter:grayscale(0.35);':''}}" wx:for="{{cards}}" wx:key="id">
      <view class="ticket-deco"></view>
      <view class="ticket-top">
        <view class="ticket-type">{{item.typeLabel}} · {{item.store_name || '全店通用'}}</view>
        <view class="ticket-badge" wx:if="{{tab==='active'}}" data-index="{{index}}" bindtap="goBookCard">去预约 ›</view>
        <view class="ticket-badge" wx:else style="background: rgba(255,255,255,0.3); color: #fff;">已使用/已失效</view>
      </view>
      <view class="ticket-name">{{item.card_name || item.typeLabel}}</view>
      <view class="ticket-meta" wx:if="{{item.validityRangeText}}">
        <text>效期 {{item.validityRangeText}}</text>
        <text class="ticket-remain {{item.validityRemainUrgent ? 'urgent' : ''}}" wx:if="{{tab==='active' && item.validityRemainText}}"> · {{item.validityRemainText}}</text>
      </view>
      <view class="ticket-meta" wx:elif="{{item.validityText}}">{{item.validityText}}</view>
      <view class="ticket-meta highlight" wx:if="{{item.remainText}}">{{item.remainText}}</view>
      <view class="ticket-rule" wx:if="{{item.ruleText}}">{{item.ruleText}}</view>
    </view>
  </view>

  <view class="cards-empty" wx:else>
    <view class="empty-icon">🎫</view>
    <view class="empty-title">{{tab === 'active' ? '暂无可用期限卡' : '暂无历史期限卡'}}</view>
    <view class="empty-desc">{{tab === 'active' ? '购买或验券后在此查看并选座预约' : '已核销预约或过期的卡片会归档在此'}}</view>
    <view class="empty-actions" wx:if="{{tab === 'active'}}">
      <view class="empty-btn primary" bindtap="goBuy">去购买</view>
      <view class="empty-btn" bindtap="goExchange">验券兑换</view>
    </view>
  </view>
</view>
