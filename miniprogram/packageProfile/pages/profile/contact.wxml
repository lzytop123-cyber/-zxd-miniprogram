<view class="page-contact page-safe-bottom">
  <view class="store-panel">
    <view class="store-label">联系哪家门店</view>
    <picker range="{{stores}}" range-key="name" bindchange="onStoreChange" disabled="{{!stores.length}}">
      <view class="store-choice">{{selectedStore ? selectedStore.name : '请选择门店'}}<text class="store-switch">切换 ›</text></view>
    </picker>
    <view class="store-address" wx:if="{{selectedStore.address}}">{{selectedStore.address}}</view>
    <view class="location-row"><text>{{locationHint}}</text><button class="location-button" bindtap="locate" loading="{{locating}}" disabled="{{locating}}">定位附近</button></view>
  </view>
  <view class="contact-card">
    <view wx:if="{{loading}}" class="contact-state">正在加载…</view>
    <view wx:elif="{{error}}" class="contact-state">{{error}}<button class="save-btn" bindtap="loadContact">重新加载</button></view>
    <block wx:elif="{{posterUrl}}">
      <view class="contact-title">{{selectedStore.name}} · 店长微信</view>
      <view class="hint">{{hint}}</view>
      <image class="poster" src="{{posterUrl}}" mode="widthFix" show-menu-by-longpress="{{true}}" binderror="onPosterError" />
      <button class="save-btn" bindtap="savePoster">保存二维码图片</button>
    </block>
    <view wx:elif="{{selectedStore}}" class="contact-state">该门店暂未提供店长二维码<view class="tip">请稍后再试</view></view>
    <view wx:else class="contact-state">选择门店，查看对应店长的微信二维码</view>
  </view>
</view>
