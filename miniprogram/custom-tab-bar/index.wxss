.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.tabbar {
  display: flex;
  align-items: center;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 0 8rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(45, 106, 79, 0.08);
  box-shadow: 0 -2rpx 12rpx rgba(28, 43, 32, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tab-item-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 80rpx;
  padding: 8rpx 6rpx;
  transition: transform 0.12s ease;
}

.tab-item:active .tab-item-inner {
  transform: scale(0.92);
}

.tab-item-icon-box {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tab-item-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-item-text {
  font-size: 20rpx;
  line-height: 1;
  color: var(--color-text-secondary);
}

.tab-item.is-on .tab-item-text {
  color: var(--color-text-brand);
  font-weight: 600;
}

/* 中间「入座」FAB：白边框 + 上凸，与实心底栏形成分离 */
.tab-item.is-center .tab-item-inner {
  gap: 4rpx;
}

.tab-item.is-center .tab-item-icon-box {
  width: 92rpx;
  height: 92rpx;
  margin-top: -52rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-bg-card);
  background: linear-gradient(135deg, #52B788 0%, #2D6A4F 100%);
  box-shadow:
    0 10rpx 24rpx rgba(45, 106, 79, 0.38),
    0 2rpx 6rpx rgba(45, 106, 79, 0.18);
  transition: transform 0.16s ease;
}

.tab-item.is-center:active .tab-item-inner {
  transform: none;
}

.tab-item.is-center:active .tab-item-icon-box {
  transform: scale(0.92);
}

.tab-item.is-center .tab-item-icon {
  width: 44rpx;
  height: 44rpx;
  /* 椅子图形上宽下窄，光学中心偏上，略下移对齐 */
  transform: translateY(3rpx);
  filter: brightness(0) invert(1);
}

.tab-item.is-center .tab-item-text {
  color: var(--color-text-brand);
  font-weight: 600;
}
