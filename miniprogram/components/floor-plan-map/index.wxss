.plan-canvas {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #f6fbf7 0%, #eef7f1 100%);
  --wall: rgba(74, 92, 82, 0.92);
  --wall-soft: rgba(74, 92, 82, 0.62);
  --desk: rgba(116, 136, 124, 0.55);
  --tint-imm: rgba(82, 183, 136, 0.05);
  --tint-std: rgba(82, 183, 136, 0.09);
  --tint-svc: rgba(110, 132, 120, 0.05);
  --dash: rgba(96, 140, 112, 0.5);
  --label: rgba(58, 80, 66, 0.62);
}

.plan-area {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.plan-move {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 0~900 (x) / 0~700 (y) 逻辑画布映射到此盒子 */
.floor {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fbfdfc 0%, #f3f9f5 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  overflow: hidden;
}

/* ============ 区域底色 ============ */
.room {
  position: absolute;
  border-radius: 10rpx;
}

.room--a {
  left: 5.333%;
  top: 6.286%;
  width: 27.41%;
  height: 40.04%;
  background: var(--tint-imm);
}

.room--b {
  left: 32.74%;
  top: 6.286%;
  width: 27.95%;
  height: 40.04%;
  background: var(--tint-imm);
}

.room--c {
  left: 60.69%;
  top: 6.286%;
  width: 33.98%;
  height: 66.2%;
  background: var(--tint-std);
}

.room--d {
  left: 5.333%;
  top: 53.4%;
  width: 27.41%;
  height: 40.32%;
  background: var(--tint-imm);
}

/* ============ 服务区（实线围合） ============ */
.svc {
  position: absolute;
  box-sizing: border-box;
  border: 4rpx solid rgba(74, 92, 82, 0.28);
  background: repeating-linear-gradient(
    135deg,
    rgba(74, 92, 82, 0.05) 0 6rpx,
    rgba(255, 255, 255, 0.4) 6rpx 12rpx
  );
  border-radius: 4rpx;
}

.svc--wc {
  left: 32.74%;
  top: 53.4%;
  width: 27.95%;
  height: 30.41%;
}

.svc--strip {
  left: 32.74%;
  top: 83.81%;
  width: 27.95%;
  height: 9.91%;
}

.strip-split {
  position: absolute;
  left: 46.98%;
  top: 83.81%;
  height: 9.91%;
  border-left: 3rpx dashed var(--dash);
}

/* ============ 1、2 号座位间 ============ */
.niche {
  position: absolute;
  box-sizing: border-box;
  left: 78.23%;
  top: 72.49%;
  width: 14.79%;
  height: 10.62%;
  border: 4rpx solid var(--wall-soft);
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.5);
}

/* ============ 墙体 ============ */
.wall {
  position: absolute;
  background: var(--wall);
  border-radius: 4rpx;
}

.wall--top {
  left: 5.333%;
  right: 5.333%;
  top: 6.286%;
  height: 7rpx;
}

.wall--left {
  left: 5.333%;
  top: 6.286%;
  bottom: 6.286%;
  width: 7rpx;
}

.wall--right {
  right: 5.333%;
  top: 6.286%;
  height: 78.94%;
  width: 7rpx;
}

.wall--bottom-l {
  left: 5.333%;
  width: 56.46%;
  bottom: 6.286%;
  height: 7rpx;
}

.wall--bottom-r {
  left: 73.84%;
  right: 5.333%;
  top: 85.23%;
  height: 7rpx;
}

.wall--notch-jamb {
  left: 73.84%;
  top: 85.23%;
  height: 8.49%;
  width: 7rpx;
}

/* 竖向隔墙：在走廊处断开 */
.wall--v1-top {
  left: 32.74%;
  top: 6.286%;
  height: 40.04%;
  width: 6rpx;
}

.wall--v1-bot {
  left: 32.74%;
  top: 53.4%;
  height: 40.32%;
  width: 6rpx;
}

.wall--v2-top {
  left: 60.69%;
  top: 6.286%;
  height: 40.04%;
  width: 6rpx;
}

.wall--v2-bot {
  left: 60.69%;
  top: 53.4%;
  height: 40.32%;
  width: 6rpx;
}

/* 走廊上横墙（room A/B 底，留 A、B 门洞） */
.wall--ct1 {
  left: 5.333%;
  width: 19.19%;
  top: 46.33%;
  height: 6rpx;
}

.wall--ct2 {
  left: 33.29%;
  width: 14.24%;
  top: 46.33%;
  height: 6rpx;
}

.wall--ct3 {
  left: 56.31%;
  width: 4.38%;
  top: 46.33%;
  height: 6rpx;
}

/* 走廊下横墙（下方房间顶，留沉浸区、卫生间门洞） */
.wall--cb1 {
  left: 5.333%;
  width: 15.89%;
  top: 53.4%;
  height: 6rpx;
}

.wall--cb2 {
  left: 29.99%;
  width: 10.97%;
  top: 53.4%;
  height: 6rpx;
}

.wall--cb3 {
  left: 49.73%;
  width: 10.96%;
  top: 53.4%;
  height: 6rpx;
}

/* ============ 门（门扇 + 开启弧线） ============ */
.door {
  position: absolute;
  box-sizing: border-box;
  border: 0 solid var(--wall-soft);
}

.door-leaf {
  position: absolute;
  width: 3rpx;
  height: 100%;
  background: var(--wall);
  border-radius: 2rpx;
}

/* 合页在左下，门扇向上，弧线收向右下 */
.door--up-r {
  border-top: 2rpx solid var(--wall-soft);
  border-right: 2rpx solid var(--wall-soft);
  border-top-right-radius: 100%;
}

.door--up-r .door-leaf {
  left: 0;
  bottom: 0;
}

/* 合页在右下，门扇向上，弧线收向左下 */
.door--up-l {
  border-top: 2rpx solid var(--wall-soft);
  border-left: 2rpx solid var(--wall-soft);
  border-top-left-radius: 100%;
}

.door--up-l .door-leaf {
  right: 0;
  bottom: 0;
}

.door--entry-l {
  left: 61.79%;
  bottom: 6.286%;
  width: 6.03%;
  height: 7.75%;
}

.door--entry-r {
  left: 67.81%;
  bottom: 6.286%;
  width: 6.03%;
  height: 7.75%;
}

/* ============ 窗户 ============ */
.win {
  position: absolute;
  box-sizing: border-box;
  background: var(--color-bg-card);
}

.win--h {
  height: 11rpx;
  border-top: 3rpx solid var(--wall);
  border-bottom: 3rpx solid var(--wall);
}

.win--h::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
  transform: translateY(-50%);
  background: var(--wall-soft);
}

.win--a {
  left: 14.54%;
  width: 9%;
  top: calc(6.286% - 2.5rpx);
}

.win--b {
  left: 42.21%;
  width: 9%;
  top: calc(6.286% - 2.5rpx);
}

.win--c {
  left: 73.18%;
  width: 9%;
  top: calc(6.286% - 2.5rpx);
}

.win--bl {
  left: 9.5%;
  width: 9%;
  bottom: calc(6.286% - 2.5rpx);
}

/* ============ 文字标签 ============ */
.lbl {
  position: absolute;
  transform: translate(-50%, -50%);
  white-space: nowrap;
  color: var(--label);
  letter-spacing: 1rpx;
  pointer-events: none;
}

.lbl--zone {
  font-size: 15rpx;
  font-weight: 600;
}

.lbl--svc {
  font-size: 12rpx;
  color: rgba(58, 80, 66, 0.42);
  font-weight: 500;
  letter-spacing: 0;
}

.lbl--za {
  left: 19.58%;
  top: 22.98%;
}

.lbl--zb {
  left: 48.08%;
  top: 22.98%;
}

.lbl--zc {
  left: 77.13%;
  top: 47.74%;
}

.lbl--zd {
  left: 19.04%;
  top: 73.56%;
}

.lbl--wc {
  left: 46.7%;
  top: 68.6%;
}

.lbl--tea {
  left: 39.86%;
  top: 88.8%;
}

.lbl--dine {
  left: 53.84%;
  top: 88.8%;
}

.lbl--entry {
  left: 66.5%;
  top: 86%;
  font-size: 14rpx;
  font-weight: 600;
  color: rgba(58, 80, 66, 0.78);
}

/* ============ 座位层 ============ */
.seats-layer {
  position: absolute;
  inset: 0;
  z-index: 8;
}

.seat-anchor {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.seat-unit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
}

.orient-v .seat-unit {
  flex-direction: column;
}

.orient-h .seat-unit {
  flex-direction: row;
}

.desk-bar {
  flex-shrink: 0;
  border-radius: 3rpx;
  background: var(--desk);
}

.orient-v .desk-bar {
  width: 30rpx;
  height: 5rpx;
}

.orient-h .desk-bar {
  width: 5rpx;
  height: 28rpx;
}

.seat-chip {
  width: 42rpx;
  height: 30rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  background: var(--color-bg-card);
  box-shadow: 0 3rpx 8rpx rgba(70, 86, 76, 0.08);
  transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
}

.seat-chip.available {
  background: linear-gradient(180deg, #6EC895 0%, #52B788 100%);
  border-color: var(--green-500);
  box-shadow: 0 3rpx 10rpx rgba(45, 106, 79, 0.28);
  animation: seat-pulse 1.8s ease-in-out infinite;
}

.seat-anchor:active .seat-chip.available {
  transform: scale(1.12);
  box-shadow: 0 0 0 6rpx rgba(82, 183, 136, 0.22), 0 6rpx 14rpx rgba(45, 106, 79, 0.3);
}

.seat-chip.reserved {
  background: #F4D89A;
  border-color: #C9A227;
  box-shadow: 0 2rpx 6rpx rgba(181, 148, 75, 0.18);
}

.seat-chip.occupied {
  background: #C9D0CB;
  border-color: rgba(90, 105, 96, 0.5);
  box-shadow: none;
}

.seat-chip.is-selected {
  background: linear-gradient(180deg, #2D6A4F 0%, #1B4332 100%);
  border: 3rpx solid var(--color-bg-card);
  box-shadow: 0 0 0 5rpx rgba(45, 106, 79, 0.35), 0 4rpx 12rpx rgba(27, 67, 50, 0.35);
  transform: scale(1.16);
  animation: none;
}

.seat-chip-label {
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
  pointer-events: none;
  color: var(--color-bg-card);
  text-shadow: 0 1rpx 1rpx rgba(0, 0, 0, 0.12);
}

.seat-chip.reserved .seat-chip-label {
  color: #6B4E13;
  text-shadow: none;
}

.seat-chip.occupied .seat-chip-label {
  color: rgba(58, 70, 62, 0.72);
  text-shadow: none;
}

.seat-chip-label--active {
  color: var(--color-bg-card);
}

@keyframes seat-pulse {
  0%, 100% {
    box-shadow: 0 3rpx 10rpx rgba(45, 106, 79, 0.28), 0 0 0 0 rgba(82, 183, 136, 0.5);
  }
  50% {
    box-shadow: 0 3rpx 10rpx rgba(45, 106, 79, 0.32), 0 0 0 8rpx rgba(82, 183, 136, 0);
  }
}
